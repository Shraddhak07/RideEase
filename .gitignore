# RideEase - gitignore

# OS generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
.DS_Store

# Editor / IDE folders
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and temp files
*.log
*.tmp
/error_log

# Local development notes (not part of the project)
notes.txt
TODO.txt

# Node.js
node_modules/
npm-debug.log*

# Images uploaded through the admin dashboard (keep the folder itself)
uploads/*
!uploads/.gitkeep

# Local environment overrides
.env
.env.local
