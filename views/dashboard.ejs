<%- include('partials/head', { title, active, currentUser, flashMessages }) %>
<section class="account-page">
  <div class="container">
    <div class="welcome-row"><div><span class="eyebrow">YOUR RIDE, YOUR PLANS</span><h1>Hey, <em><%= currentUser.full_name.split(' ')[0] %>.</em></h1><p>Here's what's happening with your rentals.</p></div><a class="btn btn-lime rounded-pill" href="/vehicles">Book a ride <i class="bi bi-arrow-up-right ms-1"></i></a></div>
    <div class="stats-grid">
      <article class="stat-tile"><span class="stat-icon icon-lime"><i class="bi bi-calendar2-check"></i></span><span class="eyebrow">ALL TIME</span><strong><%= stats.total || 0 %></strong><small>Total bookings</small></article>
      <article class="stat-tile"><span class="stat-icon icon-blue"><i class="bi bi-lightning-charge"></i></span><span class="eyebrow">ON THE ROAD</span><strong><%= stats.active || 0 %></strong><small>Active rentals</small></article>
      <article class="stat-tile"><span class="stat-icon icon-orange"><i class="bi bi-hourglass-split"></i></span><span class="eyebrow">UP NEXT</span><strong><%= stats.pending || 0 %></strong><small>Pending bookings</small></article>
      <article class="stat-tile"><span class="stat-icon icon-violet"><i class="bi bi-check2-circle"></i></span><span class="eyebrow">DONE & DUSTED</span><strong><%= stats.completed || 0 %></strong><small>Completed rentals</small></article>
    </div>
    <div class="dashboard-columns">
      <section class="panel-card recent-panel">
        <div class="panel-heading"><div><span class="eyebrow">YOUR HISTORY</span><h2>Recent bookings</h2></div><a class="text-link" href="/bookings">All bookings <i class="bi bi-arrow-right"></i></a></div>
        <% if (bookings.length) { %>
          <div class="booking-list">
            <% bookings.forEach((booking) => { %>
              <article class="booking-item"><div class="booking-avatar"><i class="bi <%= booking.type === 'Bike' ? 'bi-bicycle' : 'bi-car-front' %>"></i></div><div class="booking-main"><strong><%= booking.brand %> <%= booking.model %></strong><span><%= booking.pickup_date %> <i class="bi bi-arrow-right"></i> <%= booking.return_date %></span></div><span class="status-pill <%= statusClass(booking.booking_status) %>"><%= booking.booking_status %></span><strong class="booking-amount"><%= formatMoney(booking.total_amount) %></strong></article>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-inline"><i class="bi bi-map"></i><p>Your first adventure is waiting.</p><a href="/vehicles">Explore vehicles <i class="bi bi-arrow-right"></i></a></div>
        <% } %>
      </section>
      <aside class="panel-card profile-quick"><span class="eyebrow">YOUR ACCOUNT</span><div class="profile-large-avatar"><%= currentUser.full_name.charAt(0).toUpperCase() %></div><h2><%= currentUser.full_name %></h2><p><%= currentUser.email %></p><a class="profile-link" href="/profile">Manage your profile <i class="bi bi-arrow-up-right"></i></a><div class="quick-help"><i class="bi bi-heart"></i><span>Need a hand?<br><strong>We're here to help.</strong></span></div></aside>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
